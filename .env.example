# Copia este ficheiro para .env e preenche os valores.
# O .env NUNCA vai para o repositório (já está no .gitignore).

# Chave de sessão do Flask — gera uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Base de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartaccess
DB_USER=root
DB_PASSWORD=

# Groq (transcrição do áudio + respostas da Maiia)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
